rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function getUserEmail() {
      return request.auth.token.email.lower();
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasAnyRole(roles) {
      return isSignedIn() && (
        getUserEmail() == "dkvsmkmuhipa@gmail.com" || 
        (exists(/databases/$(database)/documents/admins/$(getUserEmail())) && 
         get(/databases/$(database)/documents/admins/$(getUserEmail())).data.role in roles)
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        getUserEmail() == "dkvsmkmuhipa@gmail.com" || 
        hasAnyRole(['owner', 'admin'])
      );
    }

    // --- Validation Helpers ---
    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['owner', 'admin', 'editor', 'finance', 'bendahara'] &&
             (!('addedAt' in data) || data.addedAt is timestamp) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp));
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['date', 'source', 'amount', 'type', 'createdAt', 'devFund', 'ops', 'category', 'allocationMode', 'expenseSource', 'status']) &&
             (data.amount is int || data.amount is float) && 
             data.type in ['income', 'expense', 'reallocation'] &&
             data.createdAt is timestamp &&
             (data.devFund is int || data.devFund is float) &&
             (data.ops is int || data.ops is float) &&
             data.source is string && data.source.size() <= 200 &&
             data.category is string &&
             data.allocationMode in ['auto', 'full_ops', 'full_dev'] &&
             data.expenseSource in ['ops', 'dev'] &&
             data.status is string &&
             // Allow optional addedBy fields
             (!('addedBy' in data) || data.addedBy is string) &&
             (!('addedByName' in data) || data.addedByName is string) &&
             (!('addedByRole' in data) || data.addedByRole is string) &&
             (!('bookingId' in data) || data.bookingId is string) &&
             (!('receiptUrl' in data) || (data.receiptUrl is string && data.receiptUrl.size() <= 1000));
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['customerName', 'phone', 'purpose', 'startDate', 'amount', 'status', 'paymentStatus']) &&
             data.customerName is string && data.customerName.size() <= 200 &&
             data.phone is string && data.phone.size() <= 100 &&
             data.purpose is string && data.purpose.size() <= 500 &&
             data.startDate is string &&
             (data.amount is int || data.amount is float) &&
             data.status in ['pending', 'approved', 'completed', 'rejected'] &&
             data.paymentStatus in ['unpaid', 'paid'];
    }

    function isValidInventory(data) {
      return data.keys().hasAll(['name', 'totalQuantity', 'goodQuantity', 'brokenQuantity', 'category']) &&
             data.name is string && data.name.size() <= 200 &&
             data.totalQuantity is int &&
             data.goodQuantity is int &&
             data.brokenQuantity is int &&
             data.category is string &&
             (!('lastUpdated' in data) || data.lastUpdated is timestamp);
    }

    function isValidMaintenanceLog(data) {
      return data.keys().hasAll(['itemName', 'action', 'date', 'performedBy']) &&
             data.itemName is string &&
             data.action is string &&
             data.date is string &&
             data.performedBy is string &&
             (!('notes' in data) || data.notes is string);
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['name', 'rating', 'comment', 'status']) &&
             data.name is string && data.name.size() <= 200 &&
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 2000 &&
             data.status in ['pending', 'approved', 'rejected'] &&
             (!('eventDate' in data) || data.eventDate is string) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidContract(data) {
      return data.keys().hasAll(['bookingId', 'generatedAt', 'status']) &&
             isValidId(data.bookingId) &&
             data.generatedAt is timestamp &&
             data.status in ['draft', 'signed', 'archived'];
    }

    // --- Rules ---

    // Koleksi Admins
    match /admins/{adminId} {
      // Izinkan list jika memiliki role yang berwenang
      allow list: if hasAnyRole(['owner', 'admin', 'finance', 'bendahara']); 
      allow get: if isSignedIn() && (getUserEmail() == adminId || isSuperAdmin());
      
      // Hanya owner/admin yang bisa menambah admin baru
      allow create: if isSuperAdmin() && isValidAdmin(incoming());
      
      allow update: if isValidAdmin(incoming()) && (
        isSuperAdmin() || (
          isSignedIn() && 
          getUserEmail() == adminId && 
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        )
      );
      
      allow delete: if isSuperAdmin() && adminId != getUserEmail(); 
    }

    // Global Config
    match /config/{docId} {
      allow read: if true;
      allow create, update: if hasAnyRole(['owner', 'admin', 'editor', 'bendahara', 'finance']);
      allow delete: if isSuperAdmin();
    }

    // Facilities / Gedung
    match /facilities/{docId} {
      allow read: if true;
      allow create, update: if hasAnyRole(['owner', 'admin', 'editor', 'bendahara']);
      allow delete: if isSuperAdmin();
    }

    // Transaksi / Keuangan
    match /transactions/{docId} {
      allow read: if true; // Publik perlu lihat data transaksi untuk transparansi
      allow create, update: if hasAnyRole(['owner', 'admin', 'finance', 'bendahara']) && isValidTransaction(incoming());
      allow delete: if hasAnyRole(['owner', 'admin', 'finance', 'bendahara']); // Izinkan finance & bendahara hapus juga jika diperlukan
    }

    // Booking Gedung
    match /bookings/{docId} {
      allow read: if true; // Publik perlu lihat jadwal
      allow create, update: if hasAnyRole(['owner', 'admin', 'editor', 'bendahara', 'finance']) && isValidBooking(incoming());
      allow delete: if hasAnyRole(['owner', 'admin', 'editor', 'bendahara', 'finance']);
    }

    // Inventaris
    match /inventory/{docId} {
      allow read: if hasAnyRole(['owner', 'admin', 'bendahara']);
      allow create, update: if hasAnyRole(['owner', 'admin', 'bendahara']) && isValidInventory(incoming());
      allow delete: if hasAnyRole(['owner', 'admin', 'bendahara']);
    }

    // Log Pemeliharaan
    match /maintenance_logs/{docId} {
      allow read: if hasAnyRole(['owner', 'admin', 'bendahara']);
      allow create: if hasAnyRole(['owner', 'admin', 'bendahara']) && isValidMaintenanceLog(incoming());
      allow update, delete: if isSuperAdmin();
    }

    // Feedback Pengguna
    match /feedback/{docId} {
      allow list: if (resource.data.status == 'approved') || hasAnyRole(['owner', 'admin', 'bendahara']);
      allow get: if true;
      allow create: if isValidFeedback(incoming()) && incoming().status == 'pending';
      allow update: if isValidFeedback(incoming()) && hasAnyRole(['owner', 'admin', 'bendahara']);
      allow delete: if isSuperAdmin();
    }

    // Kontrak Digital
    match /e_contracts/{docId} {
      allow read: if hasAnyRole(['owner', 'admin', 'bendahara']) && isValidId(docId);
      allow create, update: if hasAnyRole(['owner', 'admin', 'bendahara']) && isValidId(docId) && isValidContract(incoming());
      allow delete: if isSuperAdmin() && isValidId(docId);
    }

    // Audit Trail Log (Aktivitas Pengurus / Admin)
    match /audit_logs/{docId} {
      allow read: if hasAnyRole(['owner', 'admin', 'bendahara', 'finance', 'editor']);
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit trail
    }
  }
}

